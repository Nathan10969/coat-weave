  "filter_descriptions": {
    "doc_ids": "Patent publication identifiers used as a hard document scope.",
    "properties": "Measured or claimed coating properties.",
    "polarity": "Result polarity such as positive, negative, comparative, or mixed.",
    "example_kind": "Example class such as working, comparative, reference, control, or blank.",
    "qa_policy": "Quality-assurance inclusion policy.",
    "application_family": "Broad application domain such as marine, automotive, construction, industrial, or optical fiber.",
    "applications": "Specific use-case names only (hull, buoy, deck, etc.). Do NOT put coating-class labels such as antifouling/foul_release here — use coating_families.",
    "substrates": "Substrate or base-material names.",
    "test_methods": "Test-method names.",
    "test_standards": "Formal test-standard identifiers.",
    "material_roles": "Controlled functional roles for materials, for example resin, curing_agent, pigment, filler, additive, solvent, or catalyst.",
    "materials": "Legacy flat material names. Prefer material_groups for AND-of-OR logic. Each materials[] entry is treated as its own OR-group for compatibility.",
    "material_canonical_ids": "Canonical material IDs copied from KG vocabulary results; never invent an ID.",
    "resin_systems": "Broad document-level resin-system classification only, such as epoxy, polyurethane, acrylic, alkyd, or silicone/polysiloxane. Use materials for a more specific named chemistry.",
    "assignees": "Patent assignee or applicant organization names.",
    "property_families": "Broad property-family classifications.",
    "property_canonical_ids_soft": "Soft property canonical-ID hints from KG vocabulary results.",
    "coating_families": "Coating-class labels backed by patent_profiles.coating_family. Use canonicals antifouling, foul_release, fouling_control, or concept marine_fouling_control. Do NOT put coating-class labels in applications.",
    "publication_year": "Publication year extracted from patents.publication_date, e.g. ['2019'] or ['unknown_year']. Hard filter.",
    "material_groups": "Structured material constraints. Each group is {values:[...], roles?:[...], match:'any'}. OR within a group, AND across groups. Prefer this over flat materials when multiple concepts must all match. Resin system words (polyurethane/epoxy/...) belong in resin_systems, not as exact material tokens."
  },
