{
  "version": "2.0",
  "retrieval_policy": {
    "candidate_k": 100,
    "top_k": 50,
    "expand_top_k": 30
  },
  "tools": {
    "kg.lookup_vocabulary": {
      "parameters": {
        "query": {"type": "string", "required": true},
        "dimension": {"type": "string"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "kg.hybrid_search": {
      "parameters": {
        "query": {
          "type": "string",
          "required": true
        },
        "result_mode": {
          "type": "string",
          "enum": ["candidates", "evidence"],
          "default": "evidence",
          "description": "Use candidates when the user requests only candidate listings or no evidence expansion; use evidence for facts and supporting evidence. This controls orchestration only; retrieval budgets are service-managed."
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "candidate_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "expand_top_k": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "filters": {
          "type": "filters"
        }
      },
      "filter_fields": [
        "doc_ids",
        "properties",
        "polarity",
        "example_kind",
        "qa_policy",
        "application_family",
        "coating_families",
        "applications",
        "substrates",
        "test_methods",
        "test_standards",
        "material_roles",
        "materials",
        "material_groups",
        "material_canonical_ids",
        "resin_systems",
        "assignees",
        "publication_year",
        "property_families",
        "property_canonical_ids_soft"
      ]
    },
    "kg.sql_aggregate": {
      "parameters": {
        "intent": {
          "type": "aggregate_intent",
          "required": true
        },
        "target": {
          "type": "aggregate_target",
          "required": true
        },
        "group_by": {
          "type": "aggregate_group_list"
        },
        "filters": {
          "type": "filters"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "filter_fields": [
        "doc_ids",
        "properties",
        "polarity",
        "example_kind",
        "qa_policy",
        "application_family",
        "coating_families",
        "applications",
        "substrates",
        "test_methods",
        "test_standards",
        "material_roles",
        "materials",
        "material_groups",
        "material_canonical_ids",
        "resin_systems",
        "assignees",
        "publication_year",
        "property_families",
        "property_canonical_ids_soft"
      ]
    },
    "kg.doc_field_scan": {
      "parameters": {
        "doc_ids": {
          "type": "string_list",
          "required": true
        },
        "query": {
          "type": "string",
          "required": true
        },
        "field_groups": {
          "type": "doc_field_group_list"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "include_evidence": {
          "type": "boolean"
        }
      },
      "default_groups": [
        "test_method",
        "test_condition",
        "property",
        "result",
        "facts",
        "materials",
        "evidence"
      ],
      "allowed_groups": [
        "test_method",
        "test_condition",
        "property",
        "result",
        "facts",
        "materials",
        "evidence",
        "baseline",
        "process",
        "substrate"
      ]
    },
    "kg.expand_hyperedge_multihop": {
      "parameters": {
        "object_ids": {
          "type": "string_list",
          "required": true
        }
      }
    }
  },
  "aggregate": {
