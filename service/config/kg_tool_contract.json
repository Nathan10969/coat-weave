{
  "version": "1.0",
  "tools": {
    "kg.hybrid_search": {
      "parameters": {
        "query": {"type": "string", "required": true},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 50},
        "candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "offset": {"type": "integer", "minimum": 0},
        "expand_top_k": {"type": "integer", "minimum": 0, "maximum": 30},
        "filters": {"type": "filters"}
      },
      "filter_fields": [
        "doc_ids",
        "properties",
        "polarity",
        "example_kind",
        "qa_policy",
        "application_family",
        "applications",
        "substrates",
        "test_methods",
        "test_standards",
        "material_roles",
        "materials",
        "material_canonical_ids",
        "resin_systems",
        "assignees",
        "property_families",
        "property_canonical_ids_soft"
      ]
    },
    "kg.sql_aggregate": {
      "parameters": {
        "intent": {"type": "aggregate_intent", "required": true},
        "target": {"type": "aggregate_target", "required": true},
        "group_by": {"type": "aggregate_group_list"},
        "filters": {"type": "filters"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "filter_fields": [
        "doc_ids",
        "properties",
        "polarity",
        "example_kind",
        "qa_policy",
        "application_family",
        "applications",
        "substrates",
        "test_methods",
        "test_standards",
        "material_roles",
        "materials",
        "material_canonical_ids",
        "resin_systems",
        "assignees",
        "property_families",
        "property_canonical_ids_soft"
      ]
    },
    "kg.doc_field_scan": {
      "parameters": {
        "doc_ids": {"type": "string_list", "required": true},
        "query": {"type": "string", "required": true},
        "field_groups": {"type": "doc_field_group_list"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "include_evidence": {"type": "boolean"}
      },
      "default_groups": ["test_method", "test_condition", "property", "result", "facts", "materials", "evidence"],
      "allowed_groups": ["test_method", "test_condition", "property", "result", "facts", "materials", "evidence", "baseline", "process", "substrate"]
    },
    "kg.expand_hyperedge_multihop": {
      "parameters": {
        "object_ids": {"type": "string_list", "required": true}
      }
    }
  },
  "aggregate": {
    "intents": ["distinct_count", "list_distinct", "group_count", "numeric_distribution"],
    "targets": [
      "test_method",
      "property",
      "material",
      "material_role",
      "resin_system",
      "substrate",
      "assignee",
      "doc_id",
      "example_kind",
      "polarity",
      "amount",
      "application_family",
      "formulation"
    ],
    "group_by": [
      "test_method",
      "property",
      "material",
      "material_role",
      "resin_system",
      "substrate",
      "assignee",
      "doc_id",
      "example_kind",
      "polarity",
      "application_family",
      "publication_year"
    ]
  },
  "filter_aliases": {
    "application_family": ["application_family", "application_families"],
    "applications": ["applications", "application"],
    "substrates": ["substrates", "substrate"],
    "test_methods": ["test_methods", "test_method"],
    "test_standards": ["test_standards", "test_standard", "standards"],
    "material_roles": ["material_roles", "material_role"],
    "materials": ["materials", "material", "material_names"],
    "material_canonical_ids": ["material_canonical_ids", "material_ids"],
    "resin_systems": ["resin_systems", "resin_system"],
    "assignees": ["assignees", "assignee", "applicants"],
    "property_families": ["property_families", "property_family"],
    "property_canonical_ids_soft": ["property_canonical_ids_soft", "soft_property_canonical_ids", "property_canonical_ids"],
    "doc_ids": ["doc_ids", "doc_id"],
    "properties": ["properties", "property"],
    "polarity": ["polarity"],
    "example_kind": ["example_kind", "example_kinds"],
    "qa_policy": ["qa_policy"]
  },
  "field_types": {
    "doc_ids": "string_list",
    "properties": "string_list",
    "polarity": "string_list",
    "example_kind": "string_list",
    "qa_policy": "string",
    "application_family": "string_list",
    "applications": "string_list",
    "substrates": "string_list",
    "test_methods": "string_list",
    "test_standards": "string_list",
    "material_roles": "material_role_list",
    "materials": "string_list",
    "material_canonical_ids": "string_list",
    "resin_systems": "string_list",
    "assignees": "string_list",
    "property_families": "string_list",
    "property_canonical_ids_soft": "string_list"
  },
  "filter_descriptions": {
    "doc_ids": "Patent publication identifiers used as a hard document scope.",
    "properties": "Measured or claimed coating properties.",
    "polarity": "Result polarity such as positive, negative, comparative, or mixed.",
    "example_kind": "Example class such as working, comparative, reference, control, or blank.",
    "qa_policy": "Quality-assurance inclusion policy.",
    "application_family": "Broad application domain such as marine, automotive, construction, industrial, or optical fiber.",
    "applications": "Specific application names or use cases stated by the user.",
    "substrates": "Substrate or base-material names.",
    "test_methods": "Test-method names.",
    "test_standards": "Formal test-standard identifiers.",
    "material_roles": "Controlled functional roles for materials, for example resin, curing_agent, pigment, filler, additive, solvent, or catalyst.",
    "materials": "Specific material, chemical class, product, or resin chemistry names supplied by the user. Include useful Chinese and English aliases when known.",
    "material_canonical_ids": "Canonical material IDs copied from KG vocabulary results; never invent an ID.",
    "resin_systems": "Broad document-level resin-system classification only, such as epoxy, polyurethane, acrylic, alkyd, or silicone/polysiloxane. Use materials for a more specific named chemistry.",
    "assignees": "Patent assignee or applicant organization names.",
    "property_families": "Broad property-family classifications.",
    "property_canonical_ids_soft": "Soft property canonical-ID hints from KG vocabulary results."
  },
