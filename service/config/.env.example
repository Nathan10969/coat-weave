#
# ZenMux Anthropic-compatible alternative:
# LLM_API_PROTOCOL=anthropic
# ZENMUX_BASE_URL=https://zenmux.ai/api/anthropic

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLE_THINKING=false
QWEN_CONTEXT_WINDOW_TOKENS=1000000
QWEN_MAX_OUTPUT_TOKENS=65536
QWEN_ENABLE_THINKING=false
