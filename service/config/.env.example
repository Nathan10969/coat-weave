COATING_SERVICE_ROOT=.
COATING_DATA_ROOT=./runtime_data
COATING_API_HOST=0.0.0.0
COATING_API_PORT=8031
COATING_API_TOKEN=
COATING_DISABLE_AUTH=false
COATING_ALLOWED_IPS=

COATING_POSTGRES_DSN=postgresql://coating_api:change_me@127.0.0.1:5432/coating_api
COATING_REDIS_URL=redis://127.0.0.1:6379/2
COATING_REQUIRE_POSTGRES=false
COATING_REQUIRE_REDIS=false

KG_EXPAND_URL=http://127.0.0.1:8021/tools/kg.expand_hyperedge_multihop
KG_HYBRID_SEARCH_URL=http://127.0.0.1:8021/tools/kg.hybrid_search
KG_SQL_AGGREGATE_URL=http://127.0.0.1:8021/tools/kg.sql_aggregate
KG_DOC_FIELD_SCAN_URL=http://127.0.0.1:8021/tools/kg.doc_field_scan
KG_EXPAND_TOKEN=
KG_EXPAND_TIMEOUT_SECONDS=60

KG_EXPAND_HOST=127.0.0.1
KG_EXPAND_PORT=8021
KG_HYBRID_EMBED_URL=http://127.0.0.1:8010/embed
KG_AGGREGATE_DIR=../data/kg_aggregate
KG_HYBRID_CONFIG=../config/hyperedge_retrieval.json

LLM_API_PROTOCOL=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_CONTEXT_WINDOW_TOKENS=1000000
LLM_MAX_OUTPUT_TOKENS=65536
LLM_STREAM_CHUNK_CHARS=4

# ZenMux OpenAI-compatible example (recommended):
# LLM_API_PROTOCOL=openai
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
