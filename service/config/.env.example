COATING_SERVICE_ROOT=
COATING_DATA_ROOT=
COATING_API_HOST=0.0.0.0
COATING_API_PORT=8031
COATING_API_TOKEN=
COATING_DISABLE_AUTH=false
COATING_ALLOWED_IPS=

COATING_POSTGRES_DSN=
COATING_REDIS_URL=
COATING_REQUIRE_POSTGRES=false
COATING_REQUIRE_REDIS=false

KG_EXPAND_URL=http://127.0.0.1:8021/tools/kg.expand_hyperedge_multihop
KG_HYBRID_SEARCH_URL=http://127.0.0.1:8021/tools/kg.hybrid_search
KG_SQL_AGGREGATE_URL=http://127.0.0.1:8021/tools/kg.sql_aggregate
KG_DOC_FIELD_SCAN_URL=http://127.0.0.1:8021/tools/kg.doc_field_scan
KG_EXPAND_TOKEN=
KG_EXPAND_TIMEOUT_SECONDS=60

KG_EXPAND_HOST=127.0.0.1
KG_EXPAND_PORT=8021
KG_HYBRID_EMBED_URL=http://127.0.0.1:8010/embed
KG_AGGREGATE_DIR=
KG_HYBRID_CONFIG=

LLM_API_PROTOCOL=openai
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_API_KEY=
LLM_CONTEXT_WINDOW_TOKENS=1000000
LLM_MAX_OUTPUT_TOKENS=131072
LLM_STREAM_CHUNK_CHARS=4
LLM_STREAM_READ_TIMEOUT_SECONDS=60
LLM_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=45
LLM_STREAM_CONTENT_IDLE_TIMEOUT_SECONDS=45
LLM_STREAM_TOTAL_TIMEOUT_SECONDS=180
# 0 disables the application byte cap, not the provider token/context limit.
# Input and output share the model context; the provider validates token counts.
# A positive byte budget enables lossless whole-sample batching instead.
LLM_MODEL_PACKET_MAX_BYTES=0

# ZenMux OpenAI-compatible example (recommended):
# LLM_API_PROTOCOL=openai
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# ZENMUX_MODEL=anthropic/claude-opus-4.7
# ZENMUX_API_KEY=
# LLM_MAX_OUTPUT_TOKENS=4096
#
# ZenMux Anthropic-compatible alternative:
# LLM_API_PROTOCOL=anthropic
# ZENMUX_BASE_URL=https://zenmux.ai/api/anthropic

DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=qwen3.8-max
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLE_THINKING=false
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_API_KEY=
QWEN_CONTEXT_WINDOW_TOKENS=1000000
QWEN_MAX_OUTPUT_TOKENS=131072
QWEN_ENABLE_THINKING=false
