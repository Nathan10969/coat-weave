[Unit]
Description=Coating API FastAPI service
After=network-online.target redis.service postgresql.service coating-kg-tools.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/coat-weave/service
EnvironmentFile=/opt/coat-weave/service/.env
ExecStart=/opt/coat-weave/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8031
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
User=coatweave

[Install]
WantedBy=multi-user.target
