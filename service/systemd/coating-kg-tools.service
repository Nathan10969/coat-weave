[Unit]
Description=Coating KG read-only tools service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/coat-weave/service
EnvironmentFile=/opt/coat-weave/service/.env
Environment=KG_EXPAND_HOST=127.0.0.1
Environment=KG_EXPAND_PORT=8021
ExecStart=/opt/coat-weave/.venv/bin/python /opt/coat-weave/service/kg_tools/kg_expand_http_service.py
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
User=coatweave

[Install]
WantedBy=multi-user.target
