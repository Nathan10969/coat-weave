[Unit]
Description=Coating KG read-only tools service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/coating/coating_api_service
EnvironmentFile=/root/coating/coating_api_service/.env
Environment=KG_EXPAND_HOST=127.0.0.1
Environment=KG_EXPAND_PORT=8021
ExecStart=/root/coating/envs/coating/bin/python /root/coating/coating_api_service/kg_tools/kg_expand_http_service.py
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
User=root

[Install]
WantedBy=multi-user.target

