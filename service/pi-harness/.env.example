# Copy to .env locally. Never commit actual credentials or private endpoints.
PI_API_HOST=127.0.0.1
PI_API_PORT=8003
PI_API_TOKEN=
PI_CHAT_MODEL=coat-weave-pi
PI_CHAT_TIMEOUT_MS=300000
PI_TOOL_MODE=read-only
PI_PROJECT_CWD=.local/workspace
PI_AGENT_DIR=.local/agent
PI_EVENT_LOG_PATH=.local/events.jsonl

# Your OpenAI-compatible tool-calling model. Blank disables real model setup.
PI_LLM_BASE_URL=
PI_LLM_MODEL=
PI_LLM_API_KEY=
PI_LLM_CONTEXT_WINDOW=128000
PI_LLM_MAX_TOKENS=8192

# Read-only patent backend, separate from the model provider.
PATENT_SEARCH_URL=http://127.0.0.1:8002
PATENT_SEARCH_API_TOKEN=
PATENT_SEARCH_TIMEOUT_MS=120000
# Optional explicitly chosen JSON configuration; no automatic home discovery.
PATENT_SEARCH_CONFIG=

# Backend variables. Leave collection blank until your schema is ready.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=default
MILVUS_COLLECTION=
MILVUS_TOKEN=
MILVUS_TIMEOUT=60
VECTOR_FIELD=embedding
TEXT_FIELD=content
DOC_ID_FIELD=doc_id
TITLE_FIELD=title
PUBLICATION_NUMBER_FIELD=publication_number
SOURCE_PATH_FIELD=source_path
SPARSE_FIELD=
METRIC_TYPE=COSINE
EMBEDDING_MODEL=
EMBEDDING_URL=
EMBEDDING_DIMENSION=1024
EMBEDDING_QUERY_PROMPT=
RERANKER_MODEL=
MODEL_DEVICE=
DISTINCT_MAX_ROWS=1000000
DISTINCT_MAX_SECONDS=60

# none / local / tos. Backend has its own authorized document root.
PATENT_MD_STORAGE=none
PATENT_MD_ROOT=
PATENT_MD_TEMPLATE={doc_id}.md
PATENT_TOS_BUCKET=
PATENT_TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
PATENT_TOS_REGION=cn-shanghai
PATENT_TOS_PREFIX=patents/markdown
PATENT_TOS_TIMEOUT=30
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_SECURITY_TOKEN=
PATENT_TOS_CREDENTIALS_FILE=
