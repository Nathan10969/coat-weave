{
  "name": "coat-weave-pi-harness",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "prepare-deps": "node scripts/prepare-deps.mjs",
    "precheck": "npm run prepare-deps",
    "prebuild": "npm run prepare-deps",
    "pretest": "npm run prepare-deps",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "brace-expansion": "5.0.12",
    "typebox": "1.3.27"
  },
  "overrides": {
    "undici": "8.10.2",
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.0",
    "@types/node": "22.19.19",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
