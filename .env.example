# Qwen via OpenAI-compatible endpoint (DashScope compatible-mode).
# Get key at https://dashscope.console.aliyun.com/
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Qwen models — pick text + VLM (override VLM to qwen-vl-max for higher quality)
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus
EMBEDDING_MODEL=text-embedding-v3

# MinerU online API. JWT from https://mineru.net/apiManage/
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_TOKEN=your-jwt-here

# Postgres (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coating_kg
DB_USER=postgres
DB_PASSWORD=postgres

# Paths (use forward slashes; Path objects normalise on Windows)
PDF_INPUT_DIR=./data/pdf
MINERU_OUTPUT_DIR=./data/mineru_output

# Ontology version stamp (written into facts.ontology_version)
ONTOLOGY_VERSION=v0.1
